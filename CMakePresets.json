{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mysql-release",
      "displayName": "Release build with MySQL connector",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-mysql",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "FIRST_CPP_ENABLE_MYSQL": "ON",
        "FIRST_CPP_MYSQL_CONNECTOR_DIR": "${sourceDir}/third_party/mysql-connector-cpp"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "mysql-release",
      "configurePreset": "mysql-release"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
